{
  "name": "laraditz/crudless",
  "description": "Minimal base API controller for Laravel - full CRUD with a single property declaration.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "api",
    "crud",
    "controller",
    "rest",
    "base"
  ],
  "authors": [
    {
      "name": "Raditz Farhan",
      "homepage": "https://github.com/raditzfarhan"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/routing": "^10.0|^11.0|^12.0",
    "illuminate/database": "^10.0|^11.0|^12.0",
    "raditzfarhan/laravel-api-response": "^1.0"
  },
  "require-dev": {
    "laravel/framework": "^10.0|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Laraditz\\Crudless\\": "src/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
